{
  "name": "elephant-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local web app to browse, trim and export WoW Elephant addon chat logs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.9.0 || >=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "tsx src/server/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "~9.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "~9.39",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "luaparse": "^0.3.1",
    "typescript": "~5.9",
    "typescript-eslint": "8.73.0",
    "vite": "^6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/visitor-keys": {
      "eslint-visitor-keys": "^4.2.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
