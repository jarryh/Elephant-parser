{
  "name": "elephant-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local web app to browse, trim and export WoW Elephant addon chat logs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "~9.39",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^20.19.43",
    "eslint": "~9.39",
    "luaparse": "^0.3.1",
    "typescript": "~5.9",
    "typescript-eslint": "8.73.0",
    "vite": "^6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/visitor-keys": {
      "eslint-visitor-keys": "^4.2.1"
    }
  }
}
