# Copy these lines into .env (which Git ignores). Never put a real key in this file.

# Turns on the "Story" button. Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional. Prices are known for claude-opus-5-5, claude-opus-5, claude-fable-5-2,
# claude-sonnet-5-5, claude-sonnet-5 and claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional.
# PORT=5180
